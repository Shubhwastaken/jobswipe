SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
JWT_SECRET=replace-this-with-a-long-random-secret
# Access-token lifetime in hours (tokens expire via the `exp` claim).
JWT_TTL_HOURS=12
# Comma-separated browser origins allowed to call the API (no trailing slash).
# Set to your deployed frontend origin(s) in production. Dev frontend runs on :3000.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_PORT=8000
GROQ_API_KEY=your_groq_api_key_here
